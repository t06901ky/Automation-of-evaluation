# === Anthropic (Claude) ===
ANTHROPIC_API_KEY=sk-ant-...
# 評価用モデル。既定は claude-opus-4-6（もっとも高精度）
CLAUDE_MODEL=claude-opus-4-6

# === Google Workspace ===
# サービスアカウントの JSON キーファイルへのパス
# ドメイン全体の委任 (Domain-Wide Delegation) を有効にしておくこと
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json
# 委任するユーザー（評価データ取得のためにドメイン管理者のメールを推奨）
GOOGLE_DELEGATED_USER=admin@example.com

# === Google Sheets ===
# グレード定義シートの ID (評価基準)
# 例: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GRADE_DEFINITION_SHEET_ID=16N2D1hCDlx2Vl-Ez19WrA_lK5YLueSnaDvivL7rhSfU
GRADE_DEFINITION_SHEET_GID=979341057

# KPI / 事業計画シート (tier1, tier2 KPI)
KPI_SHEET_ID=

# アクションアイテム管理シート (c 項目)
ACTION_ITEMS_SHEET_ID=

# === Slack ===
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-...
# User Token (xoxp-...) — search.messages API に必要
SLACK_USER_TOKEN=xoxp-...

# === 評価設定 ===
# 評価対象期間 (日数) — 既定は直近90日
EVALUATION_WINDOW_DAYS=90

# レポート出力先
REPORT_OUTPUT_DIR=./reports
