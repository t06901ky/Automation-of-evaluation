# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === Google ===
# サービスアカウント JSON キーファイルのパス
# 対象シート・スライド・カレンダーにはこの SA メールに閲覧権限を付与すること
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json

# === Slack ===
# Bot User OAuth Token — channels:history, channels:read, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-...

# === 評価対象者 (PoC: COO Kota) ===
TARGET_USER_EMAIL=kota@valance.co.jp
TARGET_USER_NAME=Kota
TARGET_USER_GRADE=役員

# === Google Calendar ===
# 対象者のカレンダー ID (通常はメールアドレス)
# SA メールにカレンダーの閲覧権限を付与すること
TARGET_CALENDAR_ID=kota@valance.co.jp

# === Google Drive ===
# ドキュメント検索対象の Drive フォルダ ID (SA に閲覧権限を付与)
# 空の場合は SA がアクセス可能な全ファイルから検索
DRIVE_FOLDER_ID=
